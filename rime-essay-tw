#!/usr/bin/env bash
# Regenerate each user's Taiwan-first rime essay after rime-essay updates.
# Prints a reminder to redeploy; never restarts or reconfigures the IME.

set -uo pipefail

LOG_TAG="rime-essay-tw"
log() {
  echo "$@"
  logger -t "$LOG_TAG" -- "$@" 2>/dev/null || true
}

ROOT="${RIME_ESSAY_TW_ROOT:-/home}"
DRY_RUN="${RIME_ESSAY_TW_DRY_RUN:-0}"
TARGET_USER=""

while (($#)); do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --root)
      ROOT="$2"
      shift 2
      ;;
    --user)
      TARGET_USER="$2"
      shift 2
      ;;
    -h|--help)
      echo "usage: rime-essay-tw [--dry-run] [--root PATH] [--user NAME]"
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

LOCK_DIR="/run/lock"
[[ -w "$LOCK_DIR" ]] || LOCK_DIR="${TMPDIR:-/tmp}"
LOCK="$LOCK_DIR/rime-essay-tw.lock"
if exec 9>"$LOCK"; then
  if ! flock -n 9; then
    log "[$LOG_TAG] another update is running, skipping"
    exit 0
  fi
fi

if [[ -n "$TARGET_USER" ]]; then
  homes=("$ROOT/$TARGET_USER")
else
  homes=("$ROOT"/*)
fi

found=0
for home in "${homes[@]}"; do
  user="$(basename "$home")"
  for dir in \
    "$home/.local/share/fcitx5/rime" \
    "$home/.config/ibus/rime"; do
    [[ -d "$dir" ]] || continue
    found=1

    if [[ "$DRY_RUN" == "1" ]]; then
      log "[$LOG_TAG] 已更新 $dir/essay.txt（dry-run，未寫入）"
      log "[$LOG_TAG] 請重新部署 Rime（重新啟動 fcitx5，或使用選單的「部署」）"
      continue
    fi

    if [[ ! -f "$dir/generate_essay.py" ]]; then
      log "[$LOG_TAG] 跳過 $dir（找不到 generate_essay.py）"
      continue
    fi
    if [[ ! -f "$dir/essay_pairs.tsv" ]]; then
      log "[$LOG_TAG] 跳過 $dir（找不到 essay_pairs.tsv）"
      continue
    fi

    if ! runuser -u "$user" -- python3 "$dir/generate_essay.py" \
      --essay /usr/share/rime-data/essay.txt \
      --pairs "$dir/essay_pairs.tsv" \
      --out "$dir/essay.txt" \
      --report "$dir/essay_report.txt"; then
      log "[$LOG_TAG] 使用者 $user 更新失敗（$dir），跳過"
      continue
    fi

    old="$(awk '/^input entries:/{print $3}' "$dir/essay_report.txt" 2>/dev/null)"
    new="$(awk '/^output entries:/{print $3}' "$dir/essay_report.txt" 2>/dev/null)"
    log "[$LOG_TAG] 已更新 $dir/essay.txt（${old:-?} → ${new:-?} 條）"
    log "[$LOG_TAG] 請重新部署 Rime（重新啟動 fcitx5，或使用選單的「部署」）"
  done
done

if [[ "$found" == "0" ]]; then
  log "[$LOG_TAG] 找不到 rime 目錄（$ROOT）"
fi

exit 0
